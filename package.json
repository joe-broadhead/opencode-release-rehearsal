{
  "name": "@joe-broadhead/opencode-release-rehearsal",
  "version": "0.0.3",
  "private": true,
  "description": "TEST ONLY: a rehearsal of the release kit, copied from opencode-tavily. Not a plugin to install: it has no Jelly declaration and its plugin id is rehearsal.kit.",
  "keywords": [
    "opencode",
    "release-rehearsal"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joe-broadhead/opencode-release-rehearsal.git"
  },
  "homepage": "https://github.com/joe-broadhead/opencode-release-rehearsal#readme",
  "bugs": {
    "url": "https://github.com/joe-broadhead/opencode-release-rehearsal/issues"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./icon.svg": "./assets/icon.svg",
    "./icon-128.png": "./assets/icon-128.png",
    "./icon-256.png": "./assets/icon-256.png"
  },
  "files": [
    "dist",
    "assets/icon.svg",
    "assets/icon-128.png",
    "assets/icon-256.png",
    "skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tui.json --noEmit",
    "test": "bun test test/unit",
    "test:kit": "node --test scripts/release-kit.test.mjs",
    "test:tui": "bun test --preload @opentui/solid/preload test/tui",
    "test:host": "node tools/host-tests.mjs",
    "test:pack": "bun test test/pack",
    "lint": "bun test test/forbidden && node scripts/check-copies.mjs",
    "check": "npm run typecheck && npm run build && npm test && npm run test:kit && npm run test:tui && npm run test:host && npm run test:pack && npm run lint && npm run icons && npm run actionlint",
    "check:upstream": "bun tools/check-upstream.mjs",
    "icons": "node scripts/check-icons.mjs",
    "actionlint": "node scripts/check-actionlint.mjs",
    "capture": "node scripts/capture-tools.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.27.1",
    "@opencode/client": "2.2.3",
    "@opencode/plugin": "2.2.3",
    "@opencode/sdk": "2.2.3",
    "@opencode/theme": "2.2.3",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/bun": "1.4.4",
    "babel-preset-solid": "1.9.16",
    "esbuild": "0.28.2",
    "solid-js": "1.9.16",
    "typescript": "5.9.3"
  },
  "opencode": {
    "host": ">=2.2.3 <2.3.0",
    "icons": [
      {
        "src": "assets/icon.svg",
        "mimeType": "image/svg+xml",
        "sizes": [
          "any"
        ]
      },
      {
        "src": "assets/icon-128.png",
        "mimeType": "image/png",
        "sizes": [
          "128x128"
        ]
      },
      {
        "src": "assets/icon-256.png",
        "mimeType": "image/png",
        "sizes": [
          "256x256"
        ]
      }
    ],
    "vendor": {
      "id": "tavily",
      "name": "Tavily",
      "domain": "tavily.com"
    }
  }
}
